# ==============================================================================
# BeavArr Environment Configuration 🦫
# ==============================================================================

# TMDb (The Movie Database) API Configuration
# Get an API Key or API Read Access Token at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Overseerr / Jellyseerr Configuration
# Base URL of your Overseerr/Jellyseerr instance (no trailing slash needed)
OVERSEERR_URL=http://localhost:5055

# API Key found in Overseerr Settings -> General -> API Key
OVERSEERR_API_KEY=your_overseerr_api_key_here

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
